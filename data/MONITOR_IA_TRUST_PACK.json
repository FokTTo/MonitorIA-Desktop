{
  "schema_version": 4,
  "doc_id": "MONITOR_IA_TRUST_PACK",
  "title": "Monitor IA",
  "subtitle": "O que é o Monitor IA? — evidência paper com fees + caminho até capital real",
  "locale": "pt-BR",
  "as_of": "2026-09-30",
  "snapshot_source": "VPS · v_bot_l_fee_gate / v_bot_l_1h_fee_gate",
  "disclaimer_short": "Resultados passados em PAPER (simulação com custos de corretagem). Não são garantia de retorno futuro. Risco de perda total do capital. A curva composta por trade NÃO é o saldo da conta. Senhas do app Desktop são criptografadas (bcrypt) — a operação não tem acesso à senha em texto claro.",
  "brand": {
    "product": "Monitor IA",
    "tagline": "Trading sistemático com medição honesta dos resultados — incluindo custos — antes de pensar em capital real.",
    "contact_email": "giovanni.fochesatto@gmail.com",
    "contact_note": "Resposta em horário comercial (UTC−3). Call de 20 min para rever números ao vivo."
  },
  "page1_intro": "O Monitor IA não vende «promessa de lucro». Vende um processo: medir de verdade, mudar uma coisa de cada vez, só avançar quando os números e a segurança permitem. Este pack mostra a evidência (paper + fees), o que entra no produto, o que fica de fora — e como um cliente começa com segurança.",
  "trust_pillars": [
    {
      "title": "Medição com custos reais (fees)",
      "body": "Fees são as comissões da corretora em cada trade. No Monitor IA o gate só conta operações já com fees — Profit Factor e expectancy medem o que sobra de verdade, não lucro «bruto» maquiado."
    },
    {
      "title": "Uma mudança de cada vez",
      "body": "Entrada, saída e filtros não mudam no mesmo mês. Uma mudança por ciclo, medir, e só então manter ou reverter — sem otimismo de laboratório."
    },
    {
      "title": "Walk-forward e kill switch",
      "body": "Walk-forward valida a estratégia em períodos futuros do histórico antes de capital sério. O kill switch corta novas entradas se o dia ou a sequência de perdas passar limites."
    },
    {
      "title": "Separação paper / live",
      "body": "Paper = simulação. Live = dinheiro real. O livro oficial do robô principal (BOT_L) fica isolado. Shadows e torneio são experiências em paralelo: servem para testar ideias, mas não misturam números com o produto que vai a capital real."
    },
    {
      "title": "Infraestrutura always-on",
      "body": "O sistema corre em servidor 24/7 (VPS), com monitoramento, heartbeat e backups. Objetivo: menos falhas por PC desligado, internet instável ou processo parado no meio de um trade."
    },
    {
      "title": "Senhas criptografadas (sem acesso em texto claro)",
      "body": "No app Desktop, cada conta guarda a senha apenas como hash bcrypt (irreversível). Nem o administrador consegue ler a senha de um utilizador — só é possível repor uma senha nova. O email identifica a conta; o segredo nunca fica em aberto no sistema."
    }
  ],
  "glossary": [
    {
      "term": "Fees (custos / comissões)",
      "meaning": "O que a corretora cobra em cada operação. Ignorar fees infla o resultado. Aqui os números já vêm descontados."
    },
    {
      "term": "Gate (porta de qualidade)",
      "meaning": "Regras mínimas para dizer que o robô está maduro o bastante para avançar: amostra grande de trades, resultado médio positivo e Profit Factor acima de 1."
    },
    {
      "term": "Profit Factor",
      "meaning": "Soma dos lucros ÷ soma das perdas. Acima de 1,0 = no conjunto ganhou mais do que perdeu. Ex.: 1.26 ≈ US$ 1.26 ganho para cada US$ 1 perdido (em paper, com fees)."
    },
    {
      "term": "Expectancy (expectativa por trade)",
      "meaning": "Resultado médio de um trade, em % do valor operado (notional). Ex.: +0.0389% por operação. Não é a rentabilidade mensal da conta inteira."
    },
    {
      "term": "Taxa de acerto (win rate)",
      "meaning": "Percentual de trades que fecharam no lucro. Sozinha não prova qualidade: importa também o tamanho dos ganhos vs perdas."
    },
    {
      "term": "Notional (valor operado)",
      "meaning": "Quanto de capital está de fato na operação aberta. A expectancy é medida sobre esse valor — não automaticamente sobre todo o saldo da conta."
    },
    {
      "term": "Drawdown",
      "meaning": "Queda da curva a partir de um pico anterior até o fundo seguinte. Meses «médios» positivos podem esconder esses buracos — por isso a projeção guarda reserva para drawdown."
    },
    {
      "term": "Slippage",
      "meaning": "Diferença entre o preço esperado e o preço real de execução. Em live costuma ser um pouco pior que em paper."
    },
    {
      "term": "Walk-forward",
      "meaning": "Teste que valida a estratégia em pedaços futuros do histórico, não só no trecho em que foi «ajustada»."
    },
    {
      "term": "Kill switch (freio de emergência)",
      "meaning": "Trava automática: se o dia correr muito mal ou vier uma sequência longa de perdas, o sistema para de abrir trades novos."
    },
    {
      "term": "Hash bcrypt (senha)",
      "meaning": "Forma de guardar a senha transformada por um algoritmo de mão única. Serve para verificar se a senha está correta no login, mas não permite descobrir a senha original — inclusive para o administrador."
    },
    {
      "term": "Shadows e torneio",
      "meaning": "Robôs-sombra e experiências paralelas. Medem ideias novas sem misturar com o resultado oficial do robô principal."
    },
    {
      "term": "Paper → micro-live → real",
      "meaning": "Paper = simulação. Micro-live = pouco capital real com freios. Real = capital de verdade. O usuário decide ligar."
    }
  ],
